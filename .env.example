# Copy this file to .env and fill in your own free Postgres connection
# string (e.g. from Neon: https://neon.tech -> project -> Connection string).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/attendance?sslmode=require

# Any string you make up -- required to use /admin/import (uploading the
# school's .xls files through the browser). Set the same value here and as
# an environment variable on your host (e.g. Render).
ADMIN_TOKEN=change-me-to-something-only-you-know
